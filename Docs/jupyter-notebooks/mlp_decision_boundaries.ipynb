import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.colors import ListedColormap
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import classification_report, f1_score, accuracy_score
from google.colab import files

uploaded = files.upload()
csv_filename = list(uploaded.keys())[0]
df = pd.read_csv(csv_filename)

df["r_half_ratio"] = df["half_mass_radius"] / df["initial_half_mass_radius"]
df["target"] = ((df["bound_mass_fraction"] > 0.1) & (df["r_half_ratio"] > 0.2)).astype(int)

n_total = len(df)
n_vivi = (df["target"] == 1).sum()
n_morti = (df["target"] == 0).sum()

print(f"Dataset: {n_total} simulazioni")
print(f"Vivi: {n_vivi} ({n_vivi/n_total*100:.2f}%)")
print(f"Morti: {n_morti} ({n_morti/n_total*100:.2f}%)")

features = ["orbit_semi_major_axis", "orbit_eccentricity"]
X_raw = df[features]
y = df["target"]

X_train_raw, X_test_raw, y_train, y_test = train_test_split(
    X_raw, y, test_size=0.2, random_state=42, stratify=y
)

scaler = StandardScaler()
X_train = pd.DataFrame(scaler.fit_transform(X_train_raw), columns=features, index=X_train_raw.index)
X_test = pd.DataFrame(scaler.transform(X_test_raw), columns=features, index=X_test_raw.index)

print(f"\nTraining set: {len(X_train)} simulazioni")
print(f"  Vivi: {(y_train == 1).sum()}, Morti: {(y_train == 0).sum()}")
print(f"Test set: {len(X_test)} simulazioni")
print(f"  Vivi: {(y_test == 1).sum()}, Morti: {(y_test == 0).sum()}")

clf_mlp = MLPClassifier(hidden_layer_sizes=(16, 8), activation="relu", solver="adam", max_iter=500, random_state=42)
clf_mlp.fit(X_train, y_train)
y_pred_mlp = clf_mlp.predict(X_test)

y_test_arr = y_test.to_numpy()

plt.rcParams.update({
    "font.family": "serif",
    "font.size": 14,
    "axes.titlesize": 18,
    "axes.labelsize": 16,
    "xtick.labelsize": 14,
    "ytick.labelsize": 14,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
    "xtick.top": True,
    "ytick.right": True,
    "savefig.dpi": 300,
    "savefig.bbox": "tight",
    "mathtext.fontset": "dejavuserif",
})

GALAXY_SCALE_RADIUS = 20.0

margin_a = 0.05 * (X_raw["orbit_semi_major_axis"].max() - X_raw["orbit_semi_major_axis"].min())
margin_e = 0.05 * (X_raw["orbit_eccentricity"].max() - X_raw["orbit_eccentricity"].min())

x_min = X_raw["orbit_semi_major_axis"].min() - margin_a
x_max = X_raw["orbit_semi_major_axis"].max() + margin_a
y_min = X_raw["orbit_eccentricity"].min() - margin_e
y_max = X_raw["orbit_eccentricity"].max() + margin_e

a_vals = np.linspace(x_min, x_max, 500)
e_vals = np.linspace(y_min, y_max, 500)

xx_original, yy = np.meshgrid(a_vals, e_vals)
xx_relative = xx_original / GALAXY_SCALE_RADIUS

mesh_original = pd.DataFrame(
    np.c_[xx_original.ravel(), yy.ravel()],
    columns=features
)
mesh_scaled = pd.DataFrame(scaler.transform(mesh_original), columns=features)

mlp_class_1_index = np.where(clf_mlp.classes_ == 1)[0][0]
mlp_probabilities = clf_mlp.predict_proba(mesh_scaled)[:, mlp_class_1_index]
Z_mlp = mlp_probabilities.reshape(xx_relative.shape)

cmap_bg = ListedColormap(["#ffcccc", "#ccffcc"])

fig, ax = plt.subplots(figsize=(10, 7))

ax.contourf(
    xx_relative,
    yy,
    Z_mlp,
    levels=[0.0, 0.5, 1.0],
    cmap=cmap_bg,
    alpha=0.6
)

correct = y_pred_mlp == y_test_arr
incorrect = ~correct

is_dead_true = y_test_arr == 0
is_alive_true = y_test_arr == 1

X_test_raw_np = X_test_raw.to_numpy()

ax.scatter(
    X_test_raw_np[correct & is_dead_true, 0] / GALAXY_SCALE_RADIUS, X_test_raw_np[correct & is_dead_true, 1],
    color="#d62728", alpha=0.25, s=18, linewidth=0, label="Dissolti corretti"
)
ax.scatter(
    X_test_raw_np[correct & is_alive_true, 0] / GALAXY_SCALE_RADIUS, X_test_raw_np[correct & is_alive_true, 1],
    color="#2ca02c", alpha=0.25, s=18, linewidth=0, label="Integri corretti"
)
ax.scatter(
    X_test_raw_np[incorrect & is_dead_true, 0] / GALAXY_SCALE_RADIUS, X_test_raw_np[incorrect & is_dead_true, 1],
    color="#900c3f", linewidth=1.2, marker="x", s=45, label="Dissolti errati (falsi integri)"
)
ax.scatter(
    X_test_raw_np[incorrect & is_alive_true, 0] / GALAXY_SCALE_RADIUS, X_test_raw_np[incorrect & is_alive_true, 1],
    color="#0b6623", linewidth=1.2, marker="x", s=45, label="Integri errati (falsi dissolti)"
)

ax.set_xlim(x_min / GALAXY_SCALE_RADIUS, x_max / GALAXY_SCALE_RADIUS)
ax.set_ylim(y_min, y_max)
ax.set_title("Regioni di classificazione tramite MLP")
ax.set_xlabel(r"Semiasse maggiore relativo, $\tilde{a}$")
ax.set_ylabel("Eccentricità, $e$")
ax.grid(True, linestyle="--", alpha=0.4)

legend = ax.legend(
    loc="upper center",
    bbox_to_anchor=(0.5, -0.18),
    frameon=True,
    fontsize=11,
    ncols=4
)

for handle in legend.legend_handles[:2]:
    handle.set_alpha(1.0)
    handle.set_sizes([30])

fig.subplots_adjust(bottom=0.28)

output_filename = "mlp_decision_boundaries.pdf"
plt.savefig(output_filename, format="pdf", dpi=300, bbox_inches="tight")
plt.show()
#files.download(output_filename)

print("\n" + "=" * 50)
print("REPORT DEL CLASSIFICATORE MLP")
print("=" * 50)
print(classification_report(y_test_arr, y_pred_mlp, target_names=["Morti (0)", "Vivi (1)"]))

f1_mlp_val = f1_score(y_test_arr, y_pred_mlp, average="weighted")
acc_val = accuracy_score(y_test_arr, y_pred_mlp)

print(f"Accuracy: {acc_val:.4f}")
print(f"F1-score weighted: {f1_mlp_val:.4f}")
print("=" * 50)
