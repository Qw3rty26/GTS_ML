import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

plt.rcParams.update({
    "font.family": "serif",
    "font.size": 14,
    "axes.titlesize": 18,
    "axes.labelsize": 16,
    "xtick.labelsize": 12,
    "ytick.labelsize": 12,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
    "xtick.top": True,
    "ytick.right": True,
    "savefig.dpi": 300,
    "savefig.bbox": "tight",
    "mathtext.fontset": "dejavuserif",
})

GALAXY_SCALE_RADIUS = 20.0

uploaded = files.upload()
csv_filename = list(uploaded.keys())[0]
df = pd.read_csv(csv_filename)

print(f"Total simulations loaded: {len(df)}")

df["relative_semi_major_axis"] = df["orbit_semi_major_axis"] / GALAXY_SCALE_RADIUS
df["half_mass_radius_ratio"] = df["half_mass_radius"] / df["initial_half_mass_radius"]

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))

pivot_bmf = df.pivot_table(
    index="orbit_eccentricity",
    columns="relative_semi_major_axis",
    values="bound_mass_fraction",
    aggfunc="mean"
).sort_index().sort_index(axis=1)

pivot_hmr = df.pivot_table(
    index="orbit_eccentricity",
    columns="relative_semi_major_axis",
    values="half_mass_radius_ratio",
    aggfunc="mean"
).sort_index().sort_index(axis=1)

print(f"Maximum R_1/2 across individual simulations: {df['half_mass_radius_ratio'].max():.4f}")
print(f"Maximum R_1/2 across heatmap cells: {pivot_hmr.max().max():.4f}")

extent = [
    pivot_bmf.columns.min(),
    pivot_bmf.columns.max(),
    pivot_bmf.index.min(),
    pivot_bmf.index.max()
]

im1 = ax1.imshow(
    pivot_bmf,
    origin="lower",
    aspect="auto",
    interpolation="nearest",
    cmap="magma",
    extent=extent,
    vmin=0,
    vmax=1
)

ax1.set_title(r"Bound mass fraction, $f_{\mathrm{bound}}$")
ax1.set_xlabel(r"Relative semi-major axis, $\tilde{a}$")
ax1.set_ylabel("Eccentricity, $e$")
fig.colorbar(im1, ax=ax1, label=r"$f_{\mathrm{bound}}$", ticks=np.linspace(0, 1, 6), format="%.1f")

im2 = ax2.imshow(
    pivot_hmr,
    origin="lower",
    aspect="auto",
    interpolation="nearest",
    cmap="magma",
    extent=[
        pivot_hmr.columns.min(),
        pivot_hmr.columns.max(),
        pivot_hmr.index.min(),
        pivot_hmr.index.max()
    ],
    vmin=0,
    vmax=1
)

ax2.set_title(r"Relative half-mass radius, $\mathcal{R}_{1/2}$")
ax2.set_xlabel(r"Relative semi-major axis, $\tilde{a}$")
ax2.set_ylabel("Eccentricity, $e$")
fig.colorbar(im2, ax=ax2, label=r"$\mathcal{R}_{1/2}$", ticks=np.linspace(0, 1, 6), format="%.1f")

for ax in (ax1, ax2):
    ax.set_xlim(pivot_bmf.columns.min(), pivot_bmf.columns.max())
    ax.set_ylim(pivot_bmf.index.min(), pivot_bmf.index.max())
    ax.tick_params(which="both", direction="in", top=True, right=True)

fig.tight_layout()

output_filename = "heat_distribution_bmf_hmr_eng.pdf"
fig.savefig(output_filename, format="pdf", bbox_inches="tight")
plt.show()

