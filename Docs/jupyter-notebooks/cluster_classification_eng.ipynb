import io
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from google.colab import files

plt.rcParams.update({
    "font.family": "serif",
    "font.size": 14,
    "axes.titlesize": 18,
    "axes.labelsize": 16,
    "xtick.labelsize": 14,
    "ytick.labelsize": 14,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
    "xtick.top": True,
    "ytick.right": True,
    "savefig.dpi": 300,
    "savefig.bbox": "tight",
    "mathtext.fontset": "dejavuserif",
})

BMF_THRESHOLD = 0.1
HMR_THRESHOLD = 0.2

uploaded = files.upload()
file_name = next(iter(uploaded))
df = pd.read_csv(io.BytesIO(uploaded[file_name]), sep=None, engine="python")

columns = {
    "bmf": ["cluster_bound_mass_fraction_final", "bound_mass_fraction"],
    "initial_hmr": ["cluster_half_mass_radius_initial", "initial_half_mass_radius"],
    "final_hmr": ["cluster_half_mass_radius_final", "half_mass_radius"]
}

selected_columns = {}

for key, alternatives in columns.items():
    column = next((name for name in alternatives if name in df.columns), None)
    if column is None:
        raise ValueError(f"Missing column for '{key}'. Available columns: {df.columns.tolist()}")
    selected_columns[key] = column

for column in selected_columns.values():
    df[column] = pd.to_numeric(df[column], errors="coerce")

valid = (
    df[list(selected_columns.values())].notna().all(axis=1)
    & np.isfinite(df[list(selected_columns.values())]).all(axis=1)
    & (df[selected_columns["initial_hmr"]] > 0)
    & (df[selected_columns["final_hmr"]] >= 0)
    & (df[selected_columns["bmf"]] >= 0)
)

df_clean = df.loc[valid].copy()

if df_clean.empty:
    raise ValueError("No valid simulations found in the dataset.")

bmf = df_clean[selected_columns["bmf"]]
hmr_ratio = df_clean[selected_columns["final_hmr"]] / df_clean[selected_columns["initial_hmr"]]

is_surviving = (bmf > BMF_THRESHOLD) & (hmr_ratio > HMR_THRESHOLD)
is_dissolved = ~is_surviving

total_count = len(df_clean)
n_surviving = is_surviving.sum()
n_dissolved = is_dissolved.sum()

print("=" * 50)
print("Classification statistics:")
print(f"Valid simulations: {total_count}")
print(f"Surviving clusters: {n_surviving} ({n_surviving/total_count*100:.2f}%)")
print(f"Dissolved clusters: {n_dissolved} ({n_dissolved/total_count*100:.2f}%)")
print(f"Excluded simulations: {(~valid).sum()}")
print("=" * 50)

fig, ax = plt.subplots(figsize=(9, 7))

ax.scatter(
    bmf[is_dissolved],
    hmr_ratio[is_dissolved],
    color="#d62728",
    alpha=0.6,
    s=15,
    label="Dissolved clusters"
)

ax.scatter(
    bmf[is_surviving],
    hmr_ratio[is_surviving],
    color="#2ca02c",
    alpha=0.6,
    s=15,
    label="Surviving clusters"
)

ax.axvline(
    x=BMF_THRESHOLD,
    color="#555555",
    linestyle="--",
    linewidth=1.4,
    label=rf"Threshold $f_{{\mathrm{{bound}}}} = {BMF_THRESHOLD}$"
)

ax.axhline(
    y=HMR_THRESHOLD,
    color="#1f77b4",
    linestyle="-.",
    linewidth=1.4,
    label=rf"Threshold $\mathcal{{R}}_{{1/2}} = {HMR_THRESHOLD}$"
)

ax.set_title("Star cluster classification")
ax.set_xlabel(r"Bound mass fraction, $f_{\mathrm{bound}}$")
ax.set_ylabel(r"Relative half-mass radius, $\mathcal{R}_{1/2}$")
ax.grid(True, linestyle="--", alpha=0.5)

ax.legend(
    loc="upper center",
    bbox_to_anchor=(0.5, -0.16),
    frameon=True,
    fontsize=13,
    ncols=2
)

fig.subplots_adjust(bottom=0.24)

output_filename = "cluster_classification_eng.pdf"
plt.savefig(output_filename, format="pdf", dpi=300, bbox_inches="tight")
plt.show()

