
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.colors import ListedColormap
from google.colab import files

plt.rcParams.update({
    "font.family": "serif",
    "font.size": 14,
    "axes.titlesize": 18,
    "axes.labelsize": 16,
    "xtick.labelsize": 14,
    "ytick.labelsize": 14,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
    "xtick.top": True,
    "ytick.right": True,
    "savefig.dpi": 300,
    "savefig.bbox": "tight",
    "mathtext.fontset": "dejavuserif",
})

GALAXY_SCALE_RADIUS = 20.0

a_vals = np.linspace(0, 300 / GALAXY_SCALE_RADIUS, 500)
e_vals = np.linspace(0, 1.0, 500)
xx, yy = np.meshgrid(a_vals, e_vals)

A = -0.000136067915575
B = -9.13358876203
C = -0.074722704916
D = 0.161416252727
E = 6.46340228468
F = -12.1809014128

a_original = xx * GALAXY_SCALE_RADIUS

Z_val = (
    A * a_original**2 +
    B * yy**2 +
    C * a_original * yy +
    D * a_original +
    E * yy +
    F
)

Z_bin = (Z_val >= 0).astype(int)
cmap_bg = ListedColormap(["#ffcccc", "#ccffcc"])

fig, ax = plt.subplots(figsize=(10, 7))

ax.contourf(xx, yy, Z_bin, levels=[-0.5, 0.5, 1.5], cmap=cmap_bg, alpha=0.6)

contour = ax.contour(xx, yy, Z_val, levels=[0], colors="black", linewidths=2.0)
ax.clabel(contour, inline=True, fontsize=12, fmt="f(a,e) = 0")

ax.set_xlim(a_vals[0], a_vals[-1])
ax.set_ylim(e_vals[0], e_vals[-1])
ax.set_title("Analytical decision boundary defined by the SVC")
ax.set_xlabel(r"Relative semi-major axis, $\tilde{a}$")
ax.set_ylabel("Eccentricity, $e$")
ax.grid(True, linestyle="--", alpha=0.4)

fig.subplots_adjust(bottom=0.15)

output_filename = "svc_analytical_decision_boundary_eng.pdf"
plt.savefig(output_filename, format="pdf", dpi=300, bbox_inches="tight")
plt.show()
