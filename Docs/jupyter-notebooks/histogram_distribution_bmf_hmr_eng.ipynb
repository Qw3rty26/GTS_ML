import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

plt.rcParams.update({
    "font.family": "serif",
    "font.size": 14,
    "axes.titlesize": 18,
    "axes.labelsize": 16,
    "xtick.labelsize": 14,
    "ytick.labelsize": 14,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
    "xtick.top": True,
    "ytick.right": True,
    "savefig.dpi": 300,
    "savefig.bbox": "tight",
    "mathtext.fontset": "dejavuserif",
})

uploaded = files.upload()
csv_filename = list(uploaded.keys())[0]
df = pd.read_csv(csv_filename)

df["hmr_ratio"] = df["half_mass_radius"] / df["initial_half_mass_radius"]

OPTIMAL_THRESHOLD = 1.2993
df_filtered = df[df["hmr_ratio"] <= OPTIMAL_THRESHOLD].copy()

print(f"Simulations after filtering: {len(df_filtered)}")

bin_width = 0.025

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7), sharey=True)

bmf_values = df_filtered["bound_mass_fraction"].dropna()
bins_bmf = np.arange(0, 1.05 + bin_width, bin_width)

ax1.hist(
    bmf_values,
    bins=bins_bmf,
    color="#1f77b4",
    edgecolor="black",
    linewidth=0.9,
    alpha=0.85
)

ax1.axvline(
    x=1.0,
    color="red",
    linestyle="--",
    linewidth=2.0,
    label=r"Initial value ($f_{\mathrm{bound}} = 1.0$)"
)

ax1.set_title("Bound mass fraction distribution")
ax1.set_xlabel(r"Bound mass fraction, $f_{\mathrm{bound}}$")
ax1.set_ylabel("Number of simulations")
ax1.set_xlim(0.0, 1.08)
ax1.grid(True, linestyle="--", alpha=0.5)

ax1.legend(
    loc="upper center",
    bbox_to_anchor=(0.5, -0.16),
    frameon=True,
    fontsize=14
)

hmr_values = df_filtered["hmr_ratio"].dropna()
max_hmr = max(hmr_values.max(), OPTIMAL_THRESHOLD)
bins_hmr = np.arange(0, max_hmr + bin_width, bin_width)

ax2.hist(
    hmr_values,
    bins=bins_hmr,
    color="#1f77b4",
    edgecolor="black",
    linewidth=0.9,
    alpha=0.85
)

ax2.axvline(
    x=1.0,
    color="red",
    linestyle="--",
    linewidth=2.0,
    label=r"Initial value ($\mathcal{R}_{1/2} = 1.0$)"
)

ax2.set_title("Relative half-mass radius distribution")
ax2.set_xlabel(r"Relative half-mass radius, $\mathcal{R}_{1/2}$")
ax2.set_ylabel("Number of simulations")
ax2.set_xlim(0.0, max(max_hmr * 1.05, 1.1))
ax2.grid(True, linestyle="--", alpha=0.5)

ax2.legend(
    loc="upper center",
    bbox_to_anchor=(0.5, -0.16),
    frameon=True,
    fontsize=14
)

ax2.tick_params(axis="y", labelleft=True)

fig.subplots_adjust(bottom=0.25)

output_filename = "histogram_distribution_bmf_hmr_eng.pdf"
plt.savefig(output_filename, format="pdf", dpi=300, bbox_inches="tight")
plt.show()

